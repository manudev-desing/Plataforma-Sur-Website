# =============================================================================
# PLATAFORMA SUR · GLOBAL BUSINESS — VARIABLES DE ENTORNO (SUPABASE & CMS)
# =============================================================================
# Copia este archivo a `.env.local` y completa las credenciales de tu proyecto
# en Supabase (Project Settings -> API) para activar la persistencia en la nube.
# Si se dejan vacías, el CMS (/admin) funciona automáticamente en modo Híbrido Local.

NEXT_PUBLIC_SUPABASE_URL=https://rydypgusgpvolggdvwyb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-opcional

# Clave de acceso al panel administrador (/admin)
NEXT_PUBLIC_CMS_ADMIN_KEY=plataformasur2026

# ==============================================================================
# Cloud Tools MCP Configuration Template (.env.local)
# ==============================================================================
# Copia estas variables a tu archivo .env.local (ignorado por Git).
# No commitear secretos ni tokens reales al repositorio.

# --- Vercel MCP ---
# Crea tu token en: https://vercel.com/account/tokens
VERCEL_API_TOKEN=

# --- Firebase MCP ---
# ID de tu proyecto Firebase (ej: plataformasur-e9507)
FIREBASE_PROJECT_ID=plataformasur-e9507
# Ruta absoluta opcional a tus credenciales service-account.json de Google Cloud / Firebase
GOOGLE_APPLICATION_CREDENTIALS=
