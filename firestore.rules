rules_version = '2';

// ===============================================================
// Assumed Data Model — Plataforma Sur · Global Business CMS
// ===============================================================
//
// This security rules file enforces the schema and access rules for
// the Plataforma Sur B2B catalog & CMS (`plataformasur-e9507`):
//
// Collection: cms_products
// Document ID: {productId} (slug, e.g., "alubia-blanco-ar")
// Fields:
//   - id: string (required, immutable, must match {productId}, 2..120 chars)
//   - country: string (required, enum: 'Argentina' | 'Bolivia' | 'Perú')
//   - category: string (required, enum: 'Legumbres' | 'Granos' | 'Semillas' | 'Andinos')
//   - sort_order: number (optional, 0..100000) - display sort order
//   - es_payload: map | string (required, max 50 keys or max 100000 chars JSON) - Spanish product & datasheet record
//   - en_payload: map | string (required, max 50 keys or max 100000 chars JSON) - English product & datasheet record
//   - updated_at: string (required, ISO-8601 timestamp string, 10..64 chars)
//   - created_at: string (optional, ISO-8601 timestamp string, 10..64 chars)
//
// Collection: cms_translations
// Document ID: {locale} ('ES' | 'EN')
// Fields:
//   - locale: string (required, immutable, must match {locale}, enum: 'ES' | 'EN')
//   - dictionary: map | string (required, max 500 keys or max 100000 chars JSON) - key/value UI translation strings
//   - updated_at: string (required, ISO-8601 timestamp string, 10..64 chars)
//
// Collection: cms_company_config
// Document ID: {docId} (must be 'default')
// Fields:
//   - id: string (required, immutable, must equal 'default')
//   - config_payload: map | string (required, max 100 keys or max 100000 chars JSON) - corporate & contact settings
//   - updated_at: string (required, ISO-8601 timestamp string, 10..64 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidPayloadMapOrJson(val, maxMapKeys, maxStrLen) {
      return (val is map && val.keys().size() <= maxMapKeys) ||
        (val is string && val.size() >= 2 && val.size() <= maxStrLen);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidCmsProduct(data, productId) {
      return hasRequiredFields(['id', 'country', 'category', 'es_payload', 'en_payload', 'updated_at']) &&
        hasOnlyAllowedFields(['id', 'country', 'category', 'sort_order', 'es_payload', 'en_payload', 'updated_at', 'created_at']) &&
        data.id is string &&
        data.id == productId &&
        data.id.size() >= 2 &&
        data.id.size() <= 120 &&
        data.country in ['Argentina', 'Bolivia', 'Perú'] &&
        data.category in ['Legumbres', 'Granos', 'Semillas', 'Andinos'] &&
        (!('sort_order' in data) || (data.sort_order is number && data.sort_order >= 0 && data.sort_order <= 100000)) &&
        isValidPayloadMapOrJson(data.es_payload, 50, 100000) &&
        isValidPayloadMapOrJson(data.en_payload, 50, 100000) &&
        validStringLength('updated_at', 10, 64) &&
        isValidOptionalString('created_at', 10, 64);
    }

    function isValidCmsTranslation(data, locale) {
      return locale in ['ES', 'EN'] &&
        hasRequiredFields(['locale', 'dictionary', 'updated_at']) &&
        hasOnlyAllowedFields(['locale', 'dictionary', 'updated_at']) &&
        data.locale is string &&
        data.locale == locale &&
        data.locale in ['ES', 'EN'] &&
        isValidPayloadMapOrJson(data.dictionary, 500, 100000) &&
        validStringLength('updated_at', 10, 64);
    }

    function isValidCmsCompanyConfig(data, docId) {
      return docId == 'default' &&
        hasRequiredFields(['id', 'config_payload', 'updated_at']) &&
        hasOnlyAllowedFields(['id', 'config_payload', 'updated_at']) &&
        data.id is string &&
        data.id == 'default' &&
        data.id == docId &&
        isValidPayloadMapOrJson(data.config_payload, 100, 100000) &&
        validStringLength('updated_at', 10, 64);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. B2B Product Catalog & Bilingual Datasheets (ES / EN)
    match /cms_products/{productId} {
      allow get, list: if true;
      allow create, update: if isValidCmsProduct(request.resource.data, productId);
      allow delete: if true;
    }

    // 2. Site UI Translations Dictionary (ES / EN)
    match /cms_translations/{locale} {
      allow get, list: if true;
      allow create, update: if isValidCmsTranslation(request.resource.data, locale);
      allow delete: if false;
    }

    // 3. Corporate Contact & Commercial Settings ('default')
    match /cms_company_config/{docId} {
      allow get, list: if true;
      allow create, update: if isValidCmsCompanyConfig(request.resource.data, docId);
      allow delete: if false;
    }

    // 4. Default Deny All Other Paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
