direction: right

title: "Plataforma Sur - Hardened Anti-Scraping & Facade Architecture"

classes: {
  shield: {
    style: {
      fill: "#7f1d1d"
      stroke: "#ef4444"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 8
    }
  }
  facade: {
    style: {
      fill: "#04444D"
      stroke: "#04BA70"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 8
    }
  }
  service: {
    style: {
      fill: "#085762"
      stroke: "#38bdf8"
      font-color: "#ffffff"
      border-radius: 6
    }
  }
  data: {
    style: {
      fill: "#04BA70"
      stroke: "#04444D"
      font-color: "#04444D"
      border-radius: 6
    }
  }
}

visitor: "Visitor / Scraper Bot" {
  shape: person
}

edge_layer: "Edge & Client Hardening Layer" {
  middleware: "Next.js Edge Middleware (src/middleware.ts)" {
    class: shield
    desc: "Blocks Bot UAs (curl/wget/python/scrapy), Rate Limits IP, Injects CSP & Anti-Scrape Headers"
  }
  client_shield: "Client SecurityShield (src/components/SecurityShield.tsx)" {
    class: shield
    desc: "Blocks DevTools shortcuts (F12, Ctrl+U, Ctrl+Shift+I), ContextMenu & Image Dragging"
  }
  ui_components: "Next.js UI & API Route (/api/catalog)" {
    class: service
  }
}

facade_layer: "Mandatory Facade Layer" {
  security_facade: "SecurityFacade (src/facades/security-facade.ts)" {
    class: facade
    desc: "Orchestrates Bot Detection, Rate Limiting, Header Hardening & Payload Obfuscation"
  }
  catalog_facade: "CatalogFacade (src/facades/catalog-facade.ts)" {
    class: facade
    desc: "Orchestrates Product Filtering, Localization & Obfuscated Delivery"
  }
}

service_layer: "Service Layer" {
  security_service: "SecurityService (src/services/security-service.ts)" {
    class: service
    desc: "UA Fingerprint Regex, Sliding Window Rate Limiter, XOR+Base64 Cipher, CSP Builder"
  }
  catalog_service: "CatalogService (src/services/catalog-service.ts)" {
    class: service
    desc: "Server-side Product & Translation Repository Wrapper"
  }
}

data_store: "Protected Server Data" {
  products_db: "17 Products & Specs" {
    class: data
    shape: cylinder
  }
}

visitor -> edge_layer.middleware: "HTTP Request"
edge_layer.middleware -> facade_layer.security_facade: "inspectIncomingRequest()"
edge_layer.ui_components -> edge_layer.client_shield: "Renders Protected DOM"
edge_layer.ui_components -> facade_layer.catalog_facade: "getFilteredProducts() / getObfuscatedCatalog()"
facade_layer.catalog_facade -> facade_layer.security_facade: "encodeProtectedPayload()"
facade_layer.security_facade -> service_layer.security_service: "Delegates Bot/Rate/Cipher ops"
facade_layer.catalog_facade -> service_layer.catalog_service: "Delegates Data Queries"
service_layer.catalog_service -> data_store.products_db: "Reads Server Data"
